{
  "name": "@corebridge/msteams-mcp",
  "version": "0.29.2",
  "description": "Corebridge internal fork of msteams-mcp — MCP server for Microsoft Teams (search, send, reply, calendar, presence).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "msteams-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoreBridge/cb-msteams-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "mcp",
    "microsoft-teams",
    "teams",
    "model-context-protocol"
  ],
  "author": "Corebridge",
  "contributors": [
    "Shayan Khaksar (upstream author of @shayanline/msteams-mcp)",
    "Rob MacDonald (original author of m0nkmaster/msteams-mcp)"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.40.0",
    "zod": "~3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18"
  }
}
